{
  "name": "ha-ag-charts",
  "version": "0.0.1",
  "description": "AG Charts integration for Home Assistant",
  "main": "dist/ag-charts.js",
  "author": "Alan Treadway",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "esbuild ag-charts.ts --bundle --outfile=dist/ag-charts.js",
    "watch": "esbuild ag-charts.ts --bundle --outfile=dist/ag-charts.js --watch",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "dependencies": {
    "ag-charts-community": "^10.0.0",
    "ag-charts-enterprise": "^10.0.0",
    "lit": "^3.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.20.0",
    "typescript": "^5.0.0",
    "@types/node": "^20.11.24",
    "prettier": "^3.2.5"
  }
}
